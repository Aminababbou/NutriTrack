<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriTrack.AlimentPage"
    Title="Aliments"
    BackgroundColor="#F5F8F5">

    <CollectionView
        x:Name="AlimentsCollection"
        SelectionMode="None"
        Margin="20">

        <CollectionView.Header>
            <VerticalStackLayout Spacing="15" Padding="0,0,0,15">

                <Label
                    Text="Consulter les aliments"
                    FontSize="45"
                    FontAttributes="Bold"
                    TextColor="DarkGreen"/>
                <Button
                        Text="Consulter les aliments masqués?"
                        BackgroundColor="#2E8B57"
                        TextColor="White"
                        CornerRadius="10"
                        Clicked="OnAlimentsMasquesClicked"/>



                    <SearchBar
                    x:Name="RechercheAliment"
                    Placeholder="Rechercher un aliment..."
                    BackgroundColor="White"/>

                <Picker
                    x:Name="CategoriePicker"
                    Title="Choisir une catégorie"
                    SelectedIndexChanged="OnCategorieChanged">

                    <Picker.Items>
                        <x:String>Toutes les catégories</x:String>
                        <x:String>Fruits</x:String>
                        <x:String>Légumes</x:String>
                        <x:String>Produits laitiers</x:String>
                        <x:String>Viandes et poissons</x:String>
                        <x:String>Féculents et légumineuses</x:String>
                        <x:String>Fruits secs et graines</x:String>
                        <x:String>Boissons</x:String>
                        <x:String>Plats préparés</x:String>
                    </Picker.Items>
                </Picker>
                
            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemsLayout>
            <LinearItemsLayout
                Orientation="Vertical"
                ItemSpacing="12"/>
        </CollectionView.ItemsLayout>
        

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <Border
                    BackgroundColor="White"
                    Stroke="#E1EAE2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="12">

                    <Grid
                        ColumnDefinitions="90,*"
                        ColumnSpacing="15">

                        <Border
                            Grid.Column="0"
                            HeightRequest="85"
                            WidthRequest="85"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Image
                                Source="{Binding Image}"
                                Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="6">

                            <Label
                                Text="{Binding Nom}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#244D37"/>

                            <Label
                                Text="{Binding Categorie}"
                                FontSize="12"
                                TextColor="Gray"/>

                            <Label
                                Text="{Binding Calories, StringFormat='{0:F0} kcal / 100 g'}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#398653"/>

                            <Label
                                Text="{Binding Proteines, StringFormat='Protéines : {0:F1} g'}"
                                FontSize="12"
                                TextColor="Gray"/>

                            <Button
                                Text="Ajouter au journal"
                                BackgroundColor="#2E8B57"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnAjouterJournalClicked"/>
                            <Button
                                Text="Masquer"
                                BackgroundColor="White"
                                TextColor="#B3261E"
                                BorderColor="#B3261E"
                                BorderWidth="1"
                                CornerRadius="10"
                                Clicked="OnMasquerClicked"/>

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
