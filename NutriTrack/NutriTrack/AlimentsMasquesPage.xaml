<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="NutriTrack.AlimentsMasquesPage"
    Title="Aliments masqués"
    BackgroundColor="#F5F8F5">

    <CollectionView
        x:Name="AlimentsMasquesCollection"
        SelectionMode="None"
        Margin="20">

        <CollectionView.Header>
            <VerticalStackLayout Spacing="10" Padding="0,0,0,15">

                <Label
                    Text="Mes aliments masqués"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="#244D37"/>

                <Label
                    Text="Retrouvez ici les aliments que vous avez masqués."
                    FontSize="14"
                    TextColor="Gray"/>

            </VerticalStackLayout>
        </CollectionView.Header>

        <CollectionView.ItemsLayout>
            <LinearItemsLayout
                Orientation="Vertical"
                ItemSpacing="12"/>
        </CollectionView.ItemsLayout>

        <CollectionView.EmptyView>
            <VerticalStackLayout
                Spacing="10"
                VerticalOptions="Center"
                HorizontalOptions="Center">

                <Label
                    Text="Aucun aliment masqué."
                    FontSize="16"
                    TextColor="Gray"/>

            </VerticalStackLayout>
        </CollectionView.EmptyView>

        <CollectionView.ItemTemplate>
            <DataTemplate>

                <Border
                    BackgroundColor="White"
                    Stroke="#E1EAE2"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 15"
                    Padding="12">

                    <Grid
                        ColumnDefinitions="90,*"
                        ColumnSpacing="15">

                        <Border
                            Grid.Column="0"
                            HeightRequest="85"
                            WidthRequest="85"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">

                            <Image
                                Source="{Binding Image}"
                                Aspect="AspectFill"/>
                        </Border>

                        <VerticalStackLayout
                            Grid.Column="1"
                            VerticalOptions="Center"
                            Spacing="6">

                            <Label
                                Text="{Binding Nom}"
                                FontSize="17"
                                FontAttributes="Bold"
                                TextColor="#244D37"/>

                            <Label
                                Text="{Binding Categorie}"
                                FontSize="12"
                                TextColor="Gray"/>

                            <Label
                                Text="{Binding Calories, StringFormat='{0:F0} kcal / 100 g'}"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#398653"/>

                            <Label
                                Text="{Binding Proteines, StringFormat='Protéines : {0:F1} g'}"
                                FontSize="12"
                                TextColor="Gray"/>

                            <Button
                                Text="Réafficher"
                                BackgroundColor="#2E8B57"
                                TextColor="White"
                                CornerRadius="10"
                                Clicked="OnReafficherClicked"/>

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>

</ContentPage>
